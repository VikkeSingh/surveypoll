# Copy to .env for local dev, and set the same keys in Vercel → Project → Settings → Environment Variables.

# MongoDB connection string. Include the database name in the path.
# This is the built-in default (src/db.js) — set it here only to point elsewhere.
MONGODB_URI=mongodb+srv://dbuser:dbUserPassword@cluster0.kktk8ps.mongodb.net/surveypoll?appName=Cluster0
# Optional: override the database when the URI has none.
# MONGODB_DB=surveypoll

# Dashboard login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Secret used to sign the login cookie. Use a long random value in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# IANA timezone used for displaying timestamps and for date-range filtering.
DISPLAY_TIMEZONE=UTC

# Pin the header the client IP is read from, ignoring all others. The duplicate-IP
# rule is only as trustworthy as this value. On Vercel: x-vercel-forwarded-for
# TRUSTED_IP_HEADER=x-vercel-forwarded-for
