<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex">
    <title>Surveypoll — Saving your response</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: #000;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }
        .collect-card {
            background: #fff;
            border-radius: 8px;
            padding: 32px;
            width: 100%;
            max-width: 560px;
            text-align: center;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
        }
        .collect-title {
            font-size: 1.5rem;
            font-weight: 700;
            margin: 20px 0 8px;
        }
        .collect-subtitle { color: #555; margin-bottom: 0; }
    </style>
</head>
<body>

<div class="collect-card">
    <div class="spinner-border text-dark" role="status">
        <span class="visually-hidden">Working…</span>
    </div>
    <div class="collect-title">Saving your response…</div>
    <p class="collect-subtitle">This takes a moment. Please don't close this page.</p>

    <form id="fp-form" method="post" action="/survey/commit">
        <input type="hidden" name="token" value="<%= token %>">
        <input type="hidden" name="fingerprint" id="fp-value" value="">
        <noscript>
            <p class="collect-subtitle mt-3">JavaScript is turned off, so we can't finish automatically.</p>
            <button type="submit" class="btn btn-dark mt-2">Continue</button>
        </noscript>
    </form>
</div>

<script src="/fingerprint.js"></script>
<script>
    // Submit as soon as the fingerprint is ready, and no later than the
    // deadline: a respondent must never be stranded here because one device
    // trait hung. A missed fingerprint just means the row stores none.
    (function () {
        var DEADLINE_MS = 3000;
        var form = document.getElementById('fp-form');
        var field = document.getElementById('fp-value');
        var sent = false;

        function send() {
            if (sent) { return; }
            sent = true;
            form.submit();
        }

        setTimeout(send, DEADLINE_MS);

        try {
            window.surveypollFingerprint().then(function (fp) {
                field.value = fp || '';
                send();
            }, send);
        } catch (err) {
            send();
        }
    }());
</script>

</body>
</html>
