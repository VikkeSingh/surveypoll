<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%
        // Which rule rejected this hit. See findDuplicate() in src/surveys.js.
        const REASONS = {
            uid: {
                title: 'Duplicate Response',
                text: 'This respondent ID has already been used to submit a response.',
            },
            fingerprint: {
                title: 'Duplicate Device',
                text: 'This device has already been used to submit a response.',
            },
            ip: {
                title: 'Duplicate IP Address',
                text: 'This IP address has already been used to submit a response.',
            },
        };
        const detail = REASONS[reason] || REASONS.ip;
    %>
    <title>Surveypoll — <%= detail.title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body {
            background: #000;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }
        .dup-card {
            background: #fff;
            border-radius: 8px;
            padding: 32px;
            width: 100%;
            max-width: 560px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
        }
        .dup-icon {
            text-align: center;
            font-size: 2.5rem;
            color: #dc3545;
            line-height: 1;
        }
        .dup-title {
            font-size: 1.75rem;
            font-weight: 700;
            text-align: center;
            margin: 12px 0 8px;
        }
        .dup-subtitle {
            text-align: center;
            color: #555;
            margin-bottom: 28px;
        }
        table th {
            width: 40%;
            font-weight: 700;
            background: #f6f6f6;
        }
        table td, table th { vertical-align: middle; }
        .ip-value { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-weight: 700; }
    </style>
</head>
<body>

<div class="dup-card">
    <div class="dup-icon"><i class="bi bi-exclamation-octagon-fill"></i></div>
    <div class="dup-title"><%= detail.title %></div>
    <div class="dup-subtitle">
        <%= detail.text %>
        Your response has not been recorded.
    </div>

    <table class="table table-bordered mb-0">
        <tbody>
            <tr>
                <th>UID</th>
                <td><%= uid %></td>
            </tr>
            <tr>
                <th>PID</th>
                <td><%= pid %></td>
            </tr>
            <tr>
                <th>IP Address</th>
                <td class="ip-value"><%= ipAddress %></td>
            </tr>
            <% if (fingerprint) { %>
                <tr>
                    <th>Device ID</th>
                    <td class="ip-value"><%= fingerprint %></td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

</body>
</html>
