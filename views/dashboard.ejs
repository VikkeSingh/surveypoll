<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Surveypoll Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body { background: #fff; }
        .navbar-brand { font-size: 2rem; font-weight: 700; }
        .filter-bar {
            background: #000;
            border-radius: 6px;
            padding: 16px;
            margin: 24px 0 40px;
        }
        .filter-bar .form-control, .filter-bar .form-select { border: none; }
        .status-pill {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 6px;
            color: #fff;
            font-size: 0.8rem;
            font-weight: 600;
        }
        .status-completed { background: #28a745; }
        .status-terminated { background: #dc3545; }
        .status-quotafull { background: #fd7e14; }
        .status-security-terminate { background: #6f42c1; }
        table thead th { border-top: none; font-weight: 700; }
        table td, table th { vertical-align: middle; text-align: center; }
        /* Truncated in the cell; the title attribute carries the full value. */
        .device-id {
            font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
            font-size: 0.85rem;
            cursor: help;
        }
    </style>
</head>
<body>

<%- include('partials/nav', { user, active: 'dashboard' }) %>

<div class="container-fluid px-4">

    <!-- GET form: submitting reloads / with the filter params, server renders the table -->
    <form class="filter-bar" method="get" action="/" id="filterForm">
        <div class="row g-2 align-items-center">
            <div class="col-md">
                <input type="text" name="projectId" class="form-control" placeholder="Project ID"
                       value="<%= projectId %>">
            </div>
            <div class="col-md">
                <select name="status" class="form-select">
                    <% const statuses = [
                        ['', 'All'],
                        ['completed', 'Completed'],
                        ['terminated', 'Terminated'],
                        ['quotafull', 'Quotafull'],
                        ['security-terminate', 'Security Terminate'],
                    ]; %>
                    <% statuses.forEach(function (opt) { %>
                        <option value="<%= opt[0] %>" <%= status === opt[0] ? 'selected' : '' %>><%= opt[1] %></option>
                    <% }); %>
                </select>
            </div>
            <div class="col-md">
                <input type="date" name="startDate" class="form-control" placeholder="Start Date"
                       value="<%= startDate %>">
            </div>
            <div class="col-md">
                <input type="date" name="endDate" class="form-control" placeholder="End Date"
                       value="<%= endDate %>">
            </div>
            <div class="col-md">
                <input type="text" name="uid" class="form-control" placeholder="UID"
                       value="<%= uid %>">
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-search"></i> Filter
                </button>
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-success" formaction="/api/records/report" formmethod="get">
                    <i class="bi bi-file-earmark-arrow-down"></i> REPORT
                </button>
            </div>
        </div>
    </form>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>S.NO</th>
                <th>Project ID</th>
                <th>Username</th>
                <th>Status</th>
                <th>IP Address</th>
                <th>Device ID</th>
                <th>Country</th>
                <th>Create At</th>
            </tr>
        </thead>
        <tbody>
            <% if (records.length === 0) { %>
                <tr>
                    <td colspan="8" class="text-muted py-4">No records found</td>
                </tr>
            <% } %>
            <% records.forEach(function (r, i) { %>
                <tr>
                    <td><%= i + 1 %></td>
                    <td><%= r.projectId %></td>
                    <td><%= r.username %></td>
                    <td>
                        <span class="status-pill status-<%= String(r.status || '').toLowerCase() %>"><%= r.status %></span>
                    </td>
                    <td><%= r.ipAddress %></td>
                    <td>
                        <% if (r.fingerprint) { %>
                            <span class="device-id" title="<%= r.fingerprint %>"><%= r.fingerprint.slice(0, 16) %>…</span>
                        <% } else { %>
                            <span class="text-muted">—</span>
                        <% } %>
                    </td>
                    <td><%= r.country %></td>
                    <td><%= formatTimestamp(r.createAt) %></td>
                </tr>
            <% }); %>
        </tbody>
    </table>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
